<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="@dimen/pad_medium">

    <!-- LIBRARY MODE (default) -->
    <LinearLayout
        android:id="@+id/kitab_library_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            style="@style/JarvisTextUrdu.Title"
            android:text="@string/kitab_title" />

        <Button
            android:id="@+id/kitab_add_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/pad_small"
            style="@style/JarvisButton"
            android:text="@string/kitab_add" />

        <TextView
            android:id="@+id/kitab_loading_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/pad_medium"
            android:visibility="gone"
            style="@style/JarvisTextUrdu"
            android:text="@string/kitab_loading" />

        <TextView
            android:id="@+id/kitab_empty_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/pad_medium"
            android:visibility="gone"
            style="@style/JarvisTextUrdu"
            android:text="@string/kitab_empty" />

        <ListView
            android:id="@+id/kitab_book_list"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="@dimen/pad_small"
            android:divider="@color/divider"
            android:dividerHeight="1dp" />

    </LinearLayout>

    <!-- READER MODE -->
    <LinearLayout
        android:id="@+id/kitab_reader_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:visibility="gone">

        <Button
            android:id="@+id/kitab_back_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            style="@style/JarvisButton.Secondary"
            android:text="@string/kitab_library" />

        <TextView
            android:id="@+id/kitab_reader_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/pad_small"
            style="@style/JarvisTextUrdu.Title" />

        <ProgressBar
            android:id="@+id/kitab_reader_progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/pad_small"
            android:max="100"
            android:progress="0" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/pad_small"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/kitab_reader_chunk"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                style="@style/JarvisTextLatin.Small" />

            <TextView
                android:id="@+id/kitab_reader_percent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="@style/JarvisTextLatin.Small" />

        </LinearLayout>

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="@dimen/pad_small"
            android:background="@drawable/bg_card"
            android:padding="@dimen/pad_medium">

            <TextView
                android:id="@+id/kitab_reader_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                style="@style/JarvisTextUrdu" />

        </ScrollView>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/pad_small"
            android:orientation="horizontal">

            <Button
                android:id="@+id/kitab_play_button"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="@dimen/pad_small"
                style="@style/JarvisButton"
                android:text="@string/kitab_play" />

            <Button
                android:id="@+id/kitab_pause_button"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                style="@style/JarvisButton"
                android:text="@string/kitab_pause" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/pad_small"
            android:orientation="horizontal">

            <Button
                android:id="@+id/kitab_resume_button"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="@dimen/pad_small"
                style="@style/JarvisButton"
                android:text="@string/kitab_resume" />

            <Button
                android:id="@+id/kitab_stop_button"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                style="@style/JarvisButton.Stop"
                android:text="@string/stop_button" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/pad_small"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/kitab_speed_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:layout_marginEnd="@dimen/pad_small"
                style="@style/JarvisTextUrdu"
                android:text="@string/kitab_speed" />

            <SeekBar
                android:id="@+id/kitab_speed_bar"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_gravity="center_vertical"
                android:max="150" />

        </LinearLayout>

        <!-- Delete lives here only (v1.0.1): secondary, at the bottom of
             the reader, still with the confirm dialog. -->
        <Button
            android:id="@+id/kitab_reader_delete"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/pad_small"
            style="@style/JarvisButton.Secondary"
            android:text="@string/kitab_delete" />

    </LinearLayout>

</LinearLayout>
