<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/paper"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="@dimen/pad_large">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/app_name"
        style="@style/JarvisTextLatin"
        android:textSize="28sp"
        android:textStyle="bold"
        android:textColor="@color/navy" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/pad_medium"
        android:text="@string/lock_title"
        style="@style/JarvisTextUrdu.Title" />

    <EditText
        android:id="@+id/lock_pin"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:gravity="center"
        android:hint="@string/lock_pin_hint"
        android:inputType="numberPassword"
        android:maxLength="8"
        android:maxLines="1"
        style="@style/JarvisTextLatin" />

    <TextView
        android:id="@+id/lock_error"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/pad_small"
        android:textColor="@color/danger"
        android:visibility="gone"
        style="@style/JarvisTextUrdu" />

    <Button
        android:id="@+id/lock_unlock"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/pad_large"
        android:text="@string/lock_unlock"
        style="@style/JarvisButton" />

    <Button
        android:id="@+id/lock_fingerprint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/pad_medium"
        android:text="@string/lock_biometric"
        android:visibility="gone"
        style="@style/JarvisButton.Secondary" />

</LinearLayout>
