<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/chat_item_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:paddingBottom="4dp"
    android:paddingTop="4dp">

    <!-- Bubble: gravity (left/right) and background are set in code by role.
         User = right, bubble_user; AI = left, bubble_ai. -->
    <LinearLayout
        android:id="@+id/chat_item_bubble"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_bubble_ai"
        android:maxWidth="300dp"
        android:orientation="vertical"
        android:padding="@dimen/pad_medium">

        <TextView
            android:id="@+id/chat_item_text"
            style="@style/JarvisTextUrdu"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <!-- Per-answer actions (AI rows only; hidden for user rows) -->
        <LinearLayout
            android:id="@+id/chat_item_actions"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:visibility="gone">

            <Button
                android:id="@+id/chat_item_copy"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/jameel_noori_nastaleeq"
                android:minHeight="36dp"
                android:text="@string/chat_copy"
                android:textColor="@color/navy"
                android:textSize="14sp" />

            <Button
                android:id="@+id/chat_item_share"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/jameel_noori_nastaleeq"
                android:minHeight="36dp"
                android:text="@string/chat_share_whatsapp"
                android:textColor="@color/navy"
                android:textSize="14sp" />

            <Button
                android:id="@+id/chat_item_speak"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/jameel_noori_nastaleeq"
                android:minHeight="36dp"
                android:text="@string/chat_speak"
                android:textColor="@color/navy"
                android:textSize="14sp" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
