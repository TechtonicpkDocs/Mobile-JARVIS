<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Gemini brain, Open-Meteo weather, Aladhan prayer times. INTERNET is
         a normal permission (auto-granted, no prompt). The app works fully
         offline without it; only those three features need it. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Voice input (Mic button). Runtime permission, asked only when the
         user taps the Mic button. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />

    <!-- Reminder + prayer-time alerts (AlarmManager + notifications). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- Tasbih target vibration. -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- Book Reader background playback (foreground service, media type). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <!-- Normal (auto-granted) permission: lets the one-tap battery-
         optimization request in the Book Reader work on every ROM. -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!-- App lock: real BiometricPrompt (API 28+), PIN fallback on all APIs. -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <uses-feature android:name="android.hardware.fingerprint" android:required="false" />

    <!-- Qibla compass (graceful plain message when the sensor is absent). -->
    <uses-feature android:name="android.hardware.sensor.compass" android:required="false" />

    <!-- Auto Backup excludes the SQLite DB (a restored stale DB would run
         untested migrations on open). Prefs/files still back up. -->
    <application
        android:name=".JarvisApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Jarvis">
        <activity
            android:name=".ui.LockActivity"
            android:exported="true"
            android:configChanges="locale|layoutDirection">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".ui.MainActivity"
            android:exported="false"
            android:configChanges="locale|layoutDirection" />
        <activity
            android:name=".ui.VoicePickerActivity"
            android:exported="false"
            android:configChanges="locale|layoutDirection" />

        <!-- Reminder + prayer alarms. ReminderReceiver/PrayerReceiver show
             the notification; BootReceiver re-schedules after a reboot
             (alarms do not survive one). -->
        <receiver
            android:name=".alerts.ReminderReceiver"
            android:exported="false" />
        <receiver
            android:name=".alerts.PrayerReceiver"
            android:exported="false" />
        <receiver
            android:name=".alerts.BootReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <!-- Book Reader: foreground service so reading continues with the
             screen off and the app in the background (his core vision:
             headphones on, hands free to work). -->
        <service
            android:name=".reader.ReadingService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />
    </application>

</manifest>
